#!/bin/sh -e
VERSION="$1"

if [ -z "$VERSION" ]
then
    echo "You need to specify a version (ex. '1.0.0')"
    exit 1
fi

echo "Updating manifest.json version"
sed -E -i "" "s/\"version\": \"[0-9]+\.[0-9]+\.[0-9]+\"/\"version\": \"$VERSION\"/g" manifest.json
git add manifest.json
git commit -m "Version $VERSION"
git tag -a "v$VERSION" -m "v$VERSION"

echo "Building JS"
npm run build

echo "Zipping extension"
rm -f pullapprove-browser-extension.zip
zip -r pullapprove-browser-extension.zip dist img LICENSE manifest.json background.js

echo "Building the Firefox variant"
./scripts/build-firefox

git push && git push --tags

gh release create "v$VERSION" pullapprove-browser-extension.zip pullapprove-browser-extension-firefox.zip

# The Chrome Web Store upload is manual: the dashboard needs a signed-in
# Google account and a file picker.
cat <<MSG

Released v$VERSION on GitHub. To publish it to the Chrome Web Store:

  1. Open https://chrome.google.com/webstore/devconsole and pick PullApprove.
  2. Package > Upload new package > pullapprove-browser-extension.zip
  3. Update the listing text and screenshots if this version changed the UI.
  4. Submit for review. A version that adds permissions gets a manual review.

For Firefox, upload pullapprove-browser-extension-firefox.zip at
https://addons.mozilla.org/developers/ (the manifest there carries the
Firefox-only keys; see scripts/build-firefox).

MSG
